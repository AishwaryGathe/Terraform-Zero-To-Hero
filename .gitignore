# Terraform working directory
.terraform/
*/.terraform/

# Terraform state files (never commit these)
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Sensitive variable files
*.tfvars
*.tfvars.json

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log

# Terraform plan output
*.tfplan

# Lock file (optional, but recommended to keep)
# Remove the next line if you WANT to commit it:
.terraform.lock.hcl

# Local environment files
*.env
